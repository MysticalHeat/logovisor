LOGOVISOR_MASTER_URL=http://localhost:3000
LOGOVISOR_BOOTSTRAP_TOKEN=logovisor-bootstrap-token
LOGOVISOR_HOST_ID=local-dev-host
LOGOVISOR_LOG_FILE_PATH=/tmp/logovisor-agent.log
LOGOVISOR_DB_PATH=agent.db
LOGOVISOR_BATCH_SIZE=100
LOGOVISOR_FLUSH_INTERVAL_SECONDS=5
LOGOVISOR_HEARTBEAT_INTERVAL_SECONDS=30
LOGOVISOR_ENABLE_FILE_INPUT=true
LOGOVISOR_ENABLE_JOURNALD=false
LOGOVISOR_JOURNALD_UNITS=
