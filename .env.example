API_BIND_ADDRESS=127.0.0.1
API_PORT=13000
TRAEFIK_DOMAIN=hack.nomli-com.ru
TRAEFIK_ACME_EMAIL=admin@hack.nomli-com.ru

POSTGRES_DB=logovisor
POSTGRES_USER=logovisor
POSTGRES_PASSWORD=logovisor

CLICKHOUSE_USER=logovisor
CLICKHOUSE_PASSWORD=logovisor
CLICKHOUSE_DATABASE=default

LOGOVISOR_ENROLLMENT_TOKEN=logovisor-bootstrap-token
LOGOVISOR_ENROLLMENT_TOKEN_TTL_MINUTES=60

LOGOVISOR_AGENT_HOST_ID=docker-agent
LOGOVISOR_HOST_LOG_DIR=/tmp
LOGOVISOR_AGENT_LOG_FILENAME=logovisor-agent.log
LOGOVISOR_ENABLE_FILE_INPUT=true
LOGOVISOR_ENABLE_JOURNALD=true
LOGOVISOR_JOURNALD_UNITS=
LOGOVISOR_FLUSH_INTERVAL_SECONDS=5
LOGOVISOR_HEARTBEAT_INTERVAL_SECONDS=30
