API_BIND_ADDRESS=127.0.0.1
API_PORT=13000
TRAEFIK_DOMAIN=hack.nomli-com.ru
TRAEFIK_ACME_EMAIL=admin@hack.nomli-com.ru
LOGOVISOR_OPERATOR_USERNAME=admin
LOGOVISOR_OPERATOR_PASSWORD=change-me
LOGOVISOR_OPERATOR_JWT_SECRET=change-me-jwt-secret
LOGOVISOR_OPERATOR_JWT_EXPIRES_IN_SECONDS=28800
LOGOVISOR_OPERATOR_COOKIE_SECURE=false

POSTGRES_DB=logovisor
POSTGRES_USER=logovisor
POSTGRES_PASSWORD=logovisor

CLICKHOUSE_USER=logovisor
CLICKHOUSE_PASSWORD=logovisor
CLICKHOUSE_DATABASE=default

LOGOVISOR_ENROLLMENT_TOKEN=logovisor-bootstrap-token
LOGOVISOR_ENROLLMENT_TOKEN_TTL_MINUTES=60

LOGOVISOR_AGENT_HOST_ID=docker-agent
LOGOVISOR_HOST_LOG_DIR=/tmp
LOGOVISOR_AGENT_LOG_FILENAME=logovisor-agent.log
LOGOVISOR_ENABLE_FILE_INPUT=true
LOGOVISOR_ENABLE_JOURNALD=true
LOGOVISOR_JOURNALD_UNITS=
LOGOVISOR_FLUSH_INTERVAL_SECONDS=5
LOGOVISOR_HEARTBEAT_INTERVAL_SECONDS=30
LOGOVISOR_LOG_RETENTION_DAYS=30
LOGOVISOR_HEARTBEAT_RETENTION_DAYS=7
LOGOVISOR_TOKEN_RETENTION_DAYS=7
LOGOVISOR_HOUSEKEEPING_INTERVAL_SECONDS=3600
LOGOVISOR_ALERTS_ENCRYPTION_SECRET=change-me-alerts-secret
LOGOVISOR_ALERT_EVALUATION_INTERVAL_SECONDS=60
LOGOVISOR_ALERT_DISPATCH_INTERVAL_SECONDS=5

LOGOVISOR_GENERATOR_RATE=3
LOGOVISOR_GENERATOR_ANOMALY_ENABLED=true
